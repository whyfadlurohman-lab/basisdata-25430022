        </mxCell>
        <mxCell id="eksemplar_3" parent="eksemplar" style="text;html=1;align=left;spacingLeft=8;overflow=hidden;fontSize=12;fontColor=#000000;" value="kondisi_eksemplar" vertex="1">
          <mxGeometry height="24" width="260" y="102" as="geometry" />
        </mxCell>
        <mxCell id="eksemplar_4" parent="eksemplar" style="text;html=1;align=left;spacingLeft=8;overflow=hidden;fontSize=12;fontColor=#000000;" value="status_eksemplar" vertex="1">
          <mxGeometry height="24" width="260" y="126" as="geometry" />
        </mxCell>
        <mxCell id="ket" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=1;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#666666;" value="&lt;b&gt;Keterangan&lt;/b&gt; &amp;nbsp; PK = kunci primer &amp;nbsp; FK = kunci tamu &amp;nbsp; UQ = kunci unik &amp;nbsp; PK,FK = kunci primer komposit &amp;nbsp; &lt;b&gt;Kardinalitas&lt;/b&gt; &amp;nbsp; 1 = tepat satu &amp;nbsp; 0..1 = nol atau satu &amp;nbsp; 0..N = nol atau banyak &amp;nbsp; 1..N = satu atau banyak &amp;nbsp; &lt;i&gt;(baru)&lt;/i&gt; = atribut yang belum ada di dokumen p02 dan akan ditambahkan &amp;nbsp; &lt;i&gt;(turunan)&lt;/i&gt; = atribut turunan yang dapat dihitung dari atribut lain; keputusan disimpan atau dihitung ditetapkan di Modul 4.&lt;br&gt;&lt;b&gt;Perhitungan denda:&lt;/b&gt; denda hanya dibuat saat pengembalian (PB-03), sehingga hari terlambat = tgl_kembali_detail_peminjaman − tgl_jatuh_tempo_peminjaman dan denda_detail_peminjaman = tarif denda × hari terlambat (AB-06 dengan P = 5, yaitu Rp5.000 per hari per eksemplar). Keterlambatan berjalan untuk buku yang belum kembali (KI-04) dihitung saat kueri dari tgl_jatuh_tempo_peminjaman terhadap tanggal berjalan, bukan disimpan di denda.&lt;br&gt;&lt;i&gt;Batas maksimal 7 eksemplar per peminjaman (AB-05, P + 2) dan syarat anggota berstatus aktif (AB-02) tidak dapat dinyatakan dalam notasi Crow&#39;s Foot; dijaga sebagai aturan bisnis.&lt;/i&gt;&lt;br&gt;&lt;i&gt;Jumlah eksemplar tersedia (AB-03) tidak disimpan sebagai kolom stok, tetapi dihitung dari status_eksemplar. Tipe data dan constraint belum ditetapkan pada tahap desain konseptual (Modul 5).&lt;/i&gt;" vertex="1">
          <mxGeometry height="190" width="780" x="40" y="830" as="geometry" />
        </mxCell>
        <mxCell id="ki" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=1;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#666666;" value="PENELUSURAN KI → JALUR ERD&lt;br&gt;KI-01 Rekap peminjaman dan pengembalian harian serta bulanan → peminjaman (tgl_peminjaman) → detail_peminjaman (tgl_kembali_detail_peminjaman)&lt;br&gt;KI-02 Lima judul buku paling sering dipinjam per bulan → peminjaman → detail_peminjaman → eksemplar → buku&lt;br&gt;KI-03 Anggota paling aktif meminjam → anggota → peminjaman&lt;br&gt;KI-04 Buku yang melewati jatuh tempo dan belum kembali → anggota → peminjaman → detail_peminjaman → eksemplar → buku&lt;br&gt;KI-05 Riwayat peminjaman berdasarkan NIM atau nomor anggota → anggota → peminjaman → detail_peminjaman → eksemplar → buku" vertex="1">
          <mxGeometry height="130" width="780" x="40" y="1040" as="geometry" />
        </mxCell>
