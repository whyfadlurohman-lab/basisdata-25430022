        <mxCell id="lost" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FBE9E9;strokeColor=#A33A32;fontColor=#8B2A24;fontSize=15;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Atribut milik relasi yang tidak punya tempat&lt;/b&gt;&lt;br&gt;qty_detail_penjualan&lt;br&gt;harga_satuan_detail_penjualan" vertex="1">
